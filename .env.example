# Copy this file to .env and replace the placeholder values.

# Postgres container (used by compose.yml)
POSTGRES_USER=user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=train_ticket_api

# Connection string for the API (must match the values above)
DATABASE_URL=postgres://user:change-me@localhost:5432/train_ticket_api

# Server
PORT=8080

# JWT secrets: use long random strings, different for each (e.g. `openssl rand -base64 32`)
JWT_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# Booking
MAX_BOOKING_DAYS=4
TRAIN_TIMEZONE=Africa/Lagos

# CORS: comma-separated origins, with scheme and no trailing slash
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Logging
RUST_LOG=train_ticket=debug,tower_http=info,sqlx=warn
